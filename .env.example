# handball.net braucht keinen Login – hier stehen nur Fenster und Darstellung.
# Die Mannschaften selbst stehen in teams.json (siehe tools.teams).

# Saisonfenster (inklusive). Nur Spiele in diesem Zeitraum kommen in den Kalender.
SEASON_START=2026-08-01
SEASON_END=2027-06-30

# Zeitzone der Termine
TIMEZONE=Europe/Berlin

# Anzeigename des Kalenders im Kalender-Client
CALENDAR_NAME=Handball

# Angenommene Dauer eines Spiels in Minuten (die API liefert kein Ende)
MATCH_DURATION_MIN=120

# Optional: anderer Pfad für die Mannschaftsliste
# TEAMS_FILE=teams.json
